# Mutation cases: tests/test_logging_auditd.bats against modules/logging.sh.
# mutate-suite: modules/logging.sh tests/test_logging_auditd.bats
#
# The auditd audit: the audit=0 / audit=off branch and what counts as a rule; the
# fixes are in logging.cases.

run_case "kernel-off/never-detected" 1 \
    '        [[ "$word" == audit=0 || "$word" == audit=off ]] && { echo "$word"; return 0; }' \
    '        false && { echo "$word"; return 0; }'

run_case "kernel-off/audit-off-missed" 1 \
    '        [[ "$word" == audit=0 || "$word" == audit=off ]] && { echo "$word"; return 0; }' \
    '        [[ "$word" == audit=0 ]] && { echo "$word"; return 0; }'

# systemd compares whole words: noaudit=0 or audit=0x leave auditd startable.
run_case "kernel-off/substring-match" 1 \
    '        [[ "$word" == audit=0 || "$word" == audit=off ]] && { echo "$word"; return 0; }' \
    '        [[ "$word" == *audit=0* || "$word" == *audit=off* ]] && { echo "$word"; return 0; }'

run_case "kernel-off/unreadable-taken-as-off" 1 \
    '    read -ra words 2>/dev/null < "$LOGGING_PROC_CMDLINE" || true' \
    '    read -ra words 2>/dev/null < "$LOGGING_PROC_CMDLINE" || return 0'

run_case "kernel-off/fix-still-offered" 1 \
    '            suggestion="$(i18n '"'"'logging.fix_kernel_audit_off'"'"' "param=$param")"' \
    '            suggestion="$(i18n '"'"'logging.fix_kernel_audit_off'"'"' "param=$param")" fix="logging.enable_auditd"'

# Back to counting *.rules files: the distro's audit.rules, control lines only,
# reads as configured on every host that installed auditd from its package.
run_case "audit-rules/control-lines-count" 1 \
    "    awk '\$1 == \"-a\" || \$1 == \"-A\" || \$1 == \"-w\" { found = 1; exit } END { exit !found }' \\" \
    "    awk 'NF { found = 1; exit } END { exit !found }' \\"

run_case "audit-rules/kernel-not-asked" 1 \
    '    _logging_auditd_active || return 0' \
    '    return 0'

run_case "audit-rules/empty-kernel-set-believed" 1 \
    '    [[ "$loaded" != "No rules" ]]' \
    '    true'
