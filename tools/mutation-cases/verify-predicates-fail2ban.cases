# Mutation cases: tests/test_fix_verify_predicates.bats against modules/fail2ban.sh.
# mutate-suite: modules/fail2ban.sh tests/test_fix_verify_predicates.bats

run_case "service-ready/enabled-not-required" 1 \
    '    _f2b_service_active && _f2b_service_enabled' \
    '    _f2b_service_active'

run_case "maxretry/bound-loosened" 1 \
    '    ! { [[ "$v" =~ ^[0-9]+$ ]] && (( v > 5 )); }' \
    '    ! { [[ "$v" =~ ^[0-9]+$ ]] && (( v > 10 )); }'

# configure_ssh_jail also answers default_config: vpssec's own drop-in counts.
run_case "configured/custom-config-not-required" 1 \
    '    _f2b_ssh_jail_working && _f2b_maxretry_ok && _f2b_has_custom_config' \
    '    _f2b_ssh_jail_working && _f2b_maxretry_ok'

# A jail that bans no one passes both fixes' predicates again.
run_case "working/bans-not-required" 1 \
    '    _f2b_ssh_jail_enabled && _f2b_ssh_jail_bans' \
    '    _f2b_ssh_jail_enabled'

run_case "bans/no-action-bans" 1 \
    '    [[ -n "$actions" ]] || return 1' \
    '    :'

run_case "bans/missing-tool-ignored" 1 \
    '        check_command "$tool" || return 1' \
    '        :'

run_case "bans/iptables-family-unchecked" 1 \
    '            iptables*|ip6tables*) tool=iptables ;;' \
    '            iptables*|ip6tables*) continue ;;'

# The action list is on the line after the header; reading the header line as
# an action makes "No actions for jail sshd" read as one.
run_case "bans/header-read-as-action" 1 \
    "    actions=\$(awk '/has the following actions/ { on = 1; next } on' <<<\"\$out\" \\" \
    "    actions=\$(awk '1' <<<\"\$out\" \\"

# A jail on port ssh bans no one at an sshd that listens elsewhere.
run_case "bans/ports-unchecked" 1 \
    '        _f2b_action_covers_ssh "$jail" "$a" || return 1' \
    '        :'

run_case "ports/uncovered-ignored" 1 \
    '        (( covered )) || return 1' \
    '        :'

run_case "ports/first-covered-enough" 1 \
    '        (( covered )) || return 1' \
    '        (( covered )) && return 0'

# fail2ban keeps the blank after a comma: "ssh, 2222".
run_case "ports/blank-kept" 1 \
    '        item="${item//[[:blank:]]/}"' \
    '        :'

run_case "ports/names-unresolved" 1 \
    '            read -r _ svc _ < <(getent services "$item/tcp") || continue' \
    '            continue'

run_case "ports/protocol-kept" 1 \
    '            item="${svc%%/*}"' \
    '            item="$svc"'

run_case "ports/range-read-as-port" 1 \
    '            lo="${item%%:*}" hi="${item##*:}"' \
    '            lo="$item" hi="$item"'

run_case "covers/ufw-by-port" 1 \
    '    [[ "$2" == ufw* || "$2" == *allports* ]] && return 0' \
    '    [[ "$2" == *allports* ]] && return 0'

run_case "covers/allports-name-ignored" 1 \
    '    [[ "$2" == ufw* || "$2" == *allports* ]] && return 0' \
    '    [[ "$2" == ufw* ]] && return 0'

# A firewall action with no port attribute is not judged.
run_case "covers/no-port-attribute-fails" 1 \
    '    ports=$(fail2ban-client get "$1" action "$2" port 2>/dev/null) || return 0' \
    '    ports=$(fail2ban-client get "$1" action "$2" port 2>/dev/null) || return 1'

run_case "covers/port-list-ignored" 1 \
    '    _f2b_port_list_covers "$ports" && return 0' \
    '    :'

run_case "covers/type-allports-ignored" 1 \
    '    [[ "$(fail2ban-client get "$1" action "$2" type 2>/dev/null)" == allports ]] ||' \
    '    false ||'

run_case "covers/actiontype-allports-ignored" 1 \
    '        [[ "$(fail2ban-client get "$1" action "$2" actiontype 2>/dev/null)" == "<allports>" ]]' \
    '        false'
