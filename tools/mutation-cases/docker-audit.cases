# Mutation cases: tests/test_docker_audit.bats against modules/docker.sh.
# mutate-suite: modules/docker.sh tests/test_docker_audit.bats
#
# `docker` is a stub answering as Docker 29 or as podman-docker's shim; the socket
# is a real AF_UNIX socket behind a symlink (the suite skips without python3).

# The CLI merges adjacent published ports into one range; a port pattern that
# takes single numbers only drops the range, and with it the whole finding.
run_case "ports/range-dropped" 1 \
    '            if (port ~ /^[0-9]+(-[0-9]+)?$/) print port' \
    '            if (port ~ /^[0-9]+$/) print port'

# Without the range in the address strip, a loopback range reads as public.
run_case "ports/loopback-range-public" 1 \
    '            addr = hp; sub(/:[0-9]+(-[0-9]+)?$/, "", addr); gsub(/[][]/, "", addr)' \
    '            addr = hp; sub(/:[0-9]+$/, "", addr); gsub(/[][]/, "", addr)'

# A symlink's own mode is 777; the socket behind it is what callers reach.
run_case "sock/link-mode-read" 1 \
    '    stat -L -c '"'"'%a'"'"' "$DOCKER_SOCK" 2>/dev/null' \
    '    stat -c '"'"'%a'"'"' "$DOCKER_SOCK" 2>/dev/null'

# podman-docker answers `docker info`, so only its version string tells it apart.
run_case "podman/not-detected" 1 \
    '    [[ "$(docker --version 2>/dev/null)" == [Pp]odman* ]]' \
    '    false'

run_case "podman/daemon-settings-read" 1 \
    '    if _docker_is_podman; then' \
    '    if false; then'

# userns-remap and ICC are dockerd settings too.
run_case "podman/userns-read" 1 \
    '    if (( ! podman )); then' \
    '    if true; then'

run_case "podman/icc-read" 2 \
    '    if (( ! podman )); then' \
    '    if true; then'

# dockerd stores the old seccomp:unconfined spelling as typed.
run_case "seccomp/colon-spelling-missed" 1 \
    '            | jq -e '"'"'.[0].HostConfig.SecurityOpt // [] | any(test("^seccomp[=:]unconfined$"))'"'"' &>/dev/null; then' \
    '            | jq -e '"'"'.[0].HostConfig.SecurityOpt // [] | any(. == "seccomp=unconfined")'"'"' &>/dev/null; then'

# --user 0:0 compared whole is not "0", so the container reads as non-root.
run_case "root/user-group-compared-whole" 1 \
    '            user="${user%%:*}"' \
    '            :'

# Config.User alone: an entrypoint that su-execs to redis reads as root again.
run_case "root/process-not-asked" 1 \
    '        uid=$(_docker_pid_uid "$pid")' \
    '        uid=""'

# The host's uid taken as the container's: under userns-remap root reads as 165536.
run_case "root/uid-map-ignored" 1 \
    '    awk -v u="$uid" '"'"'$2 <= u + 0 && u + 0 < $2 + $3 { print u - $2 + $1; exit }'"'"' \' \
    '    awk -v u="$uid" '"'"'{ print u; exit }'"'"' \'

# Every container counted, granted capabilities or not.
run_case "caps/empty-capadd-counted" 1 \
    '        if [[ -n "$caps" ]]; then' \
    '        if true; then'

# The finding stops saying what each container was granted.
run_case "caps/names-only" 1 \
    '            cap_containers+=("${name}: ${caps}")' \
    '            cap_containers+=("$name")'

run_case "caps/desc-dropped" 1 \
    '            desc="$(i18n '"'"'docker.added_capabilities_desc'"'"' "list=$container_list")" \' \
    '            desc="" \'

# The description sentence back in the suggestion slot.
run_case "caps/suggestion-is-description" 1 \
    '            suggestion="$(i18n '"'"'docker.added_capabilities_suggestion'"'"')"' \
    '            suggestion="$(i18n '"'"'docker.added_capabilities_desc'"'"')"'

# Unbounded, a daemon that never answers holds the whole audit.
run_case "probe/no-timeout" 1 \
    '    timeout "$DOCKER_PROBE_TIMEOUT" docker "$@" || rc=$?' \
    '    docker "$@" || rc=$?'

# Without timeout(1) a host with a running daemon reads as unreachable.
run_case "probe/no-timeout-tool-unreachable" 1 \
    '    check_command timeout || { docker "$@"; return; }' \
    '    check_command timeout || return 1'

# Bounded but not short-circuited, a daemon that hangs mid-audit costs the
# timeout once per container and per check.
run_case "stall/not-short-circuited" 1 \
    '    [[ -e "$DOCKER_STALL_MARK" ]] && return 124' \
    '    :'

run_case "stall/not-marked" 1 \
    '        : > "$DOCKER_STALL_MARK"' \
    '        :'

# A stall that is not reported leaves the audit complete on half the answers.
run_case "stall/audit-not-incomplete" 1 \
    '        _module_record_failure docker query' \
    '        :'

run_case "stall/no-finding" 1 \
    '        check_emit "docker.query_incomplete" info failed \' \
    '        : \'

# Occurrence 2 is the privileged check's; 1 is the published-ports one.
run_case "stall/ports-passed-anyway" 1 \
    '    elif ! _docker_stalled; then' \
    '    else'

run_case "stall/privileged-passed-anyway" 2 \
    '    elif ! _docker_stalled; then' \
    '    else'

run_case "stall/memory-passed-anyway" 9 \
    '    elif ! _docker_stalled; then' \
    '    else'

# A mark left over from the previous run fails every docker call at once.
run_case "stall/stale-mark-kept" 1 \
    '    rm -f "$DOCKER_STALL_MARK"' \
    '    :'

# The env-secret sample joined without its separator, or not cut at five.
run_case "env/sample-separator-lost" 1 \
    '        sample="${sample//$'"'"'\n'"'"'/; }"' \
    '        sample="${sample//$'"'"'\n'"'"'/;}"'

run_case "env/sample-not-capped" 1 \
    '        local sample; sample=$(head -5 <<<"$hits")' \
    '        local sample; sample=$hits'

# docker info is userns's only source: after a stall, grep matching nothing is no answer.
run_case "userns/stall-reads-as-off" 6 \
    '    elif ! _docker_stalled; then' \
    '    else'

# ICC on docker0 is info only while no running container is attached to it.
run_case "icc/empty-bridge-scored" 1 \
    "    if [[ \"\$(_docker network inspect bridge --format '{{len .Containers}}' 2>/dev/null)\" == 0 ]]; then" \
    '    if false; then'

run_case "icc/any-bridge-unscored" 1 \
    "    if [[ \"\$(_docker network inspect bridge --format '{{len .Containers}}' 2>/dev/null)\" == 0 ]]; then" \
    '    if true; then'

# The docker snap's dockerd reads its own daemon.json and runs as snap.docker.dockerd, so
# the daemon.json fixes change nothing there and the suggestions must name its file.
run_case "snap/not-detected" 1 \
    '    [[ "$root" == "$DOCKER_SNAP_DATA"/* ]]' \
    '    false'

run_case "snap/fixes-offered" 1 \
    '    _docker_is_snap && snap=1' \
    '    :'

run_case "snap/nnp-fix-offered" 1 \
    '        ((snap)) || fix_id="docker.enable_no_new_privileges"' \
    '        fix_id="docker.enable_no_new_privileges"'

run_case "snap/etc-file-named" 1 \
    "        printf '%s\\n' \"path=\$DOCKER_SNAP_DATA/current/config/daemon.json\" \\" \
    "        printf '%s\\n' \"path=\$DOCKER_DAEMON_JSON\" \\"

run_case "snap/docker-service-reloaded" 1 \
    '            "reload=systemctl kill -s HUP --kill-whom=main snap.docker.dockerd" \' \
    '            "reload=systemctl reload docker" \'

run_case "snap/docker-service-restarted" 1 \
    '            "restart=snap restart docker"' \
    '            "restart=systemctl restart docker"'

# Without the params a suggestion shows {path} and {restart} as written.
run_case "where/daemon-settings-unfilled" 1 \
    '    mapfile -t where < <(_docker_daemon_where)' \
    '    :'

run_case "where/nnp-params-dropped" 1 \
    "            suggestion=\"\$(i18n 'docker.no_new_privileges_disabled_suggestion' \"\${where[@]}\")\" \\" \
    "            suggestion=\"\$(i18n 'docker.no_new_privileges_disabled_suggestion')\" \\"

run_case "where/userns-unfilled" 1 \
    '        mapfile -t where < <(_docker_daemon_where)' \
    '        :'

run_case "where/icc-unfilled" 2 \
    '    mapfile -t where < <(_docker_daemon_where)' \
    '    :'

# ICC off falls through to the "on" findings as well.
run_case "icc/passed-falls-through" 7 \
    '        return' \
    '        :'
