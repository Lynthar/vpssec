# Runtime directories (created during execution)
logs/
state/
reports/
backups/
templates/

# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/

# SMB share artifacts. This repo is worked on over a network share, where
# deleting an open file leaves a server-side .smbdeleteXXXX rename behind
# (and renames it again on each attempt). They are never ours to commit.
.smbdelete*
